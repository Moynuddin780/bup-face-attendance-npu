# BUP Attendance — runtime configuration (setup.sh copies this to .env and
# generates BUP_SECRET_KEY). Read by run.sh and docker compose.

# Flask session signing key. Keep it secret and stable (changing it logs everyone out).
BUP_SECRET_KEY=change-me

# Camera stream: "sub" = sub-stream (CPU-cheap decode), "main" = full resolution.
STREAM_PROFILE=sub
# RTSP transport: tcp (default, no packet-loss smearing) | udp | udp+tcp
RTSP_TRANSPORT=tcp

# NPU models (relative to the app dir, or absolute)
DET_MODEL_PATH=models/scrfd-10g_640x640.dxnn
REC_MODEL_PATH=models/arcface_w600k_r50_112x112.dxnn

# Web server
BUP_HOST=0.0.0.0
BUP_PORT=5000
GUNICORN_THREADS=16

# DXRT: SCRFD10G has a CPU (ONNX Runtime) tail task — run it multi-threaded.
DXRT_DYNAMIC_CPU_THREAD=ON

# Never enable in production (Werkzeug debugger = remote code execution).
FLASK_DEBUG=0

# Docker: container user (setup.sh fills these with your uid/gid)
BUP_UID=1000
BUP_GID=1000

# Live view (MJPEG) JPEG quality 1-100: lower = lighter for phones on Wi-Fi.
LIVE_JPEG_QUALITY=80

# Video decoding on the Intel iGPU (VA-API): auto | off. Streams wider than GPU_MAX_WIDTH are scaled on the GPU.
HW_DECODE=auto
GPU_MAX_WIDTH=1920
# Live view frame rate cap (the feed shows every camera frame up to this rate).
LIVE_FEED_FPS=30
# Playout buffer in ms for cameras with bursty Wi-Fi delivery (0 = off).
LIVE_SMOOTH_MS=0
# Face tracking (ByteTrack): seconds a hidden face keeps its track (and name), seconds between
# ArcFace re-checks of a recognised track, ArcFace budget per frame and camera.
TRACK_LOST_S=2.0
TRACK_REVERIFY_S=1.0
MAX_EMBED_PER_FRAME=12
# Recorded-video testing: floors ("FACULTY/FLOOR", comma separated) whose room cameras may play an
# uploaded recording instead of their RTSP stream; upload size limit and disk space kept free (MB).
VIDEO_TEST_FLOORS=FST/11
TEST_VIDEO_MAX_MB=2048
TEST_VIDEO_MIN_FREE_MB=1024
# Running classes are snapshotted to db/live_sessions.json every 5 s and resume by themselves after
# a server restart (crash, deploy, reboot). Down longer than this (seconds): not resumed — the
# teacher reviews and saves the attendance measured until then instead.
RESUME_MAX_GAP_S=1800
